<?xml version="1.0" encoding="UTF-8"?>
<Panel id="0" name="FMLPreferencesPanel" layout="twocols" border="empty" borderTop="5" borderLeft="0" borderRight="0" borderBottom="0" controllerClassName="org.openflexo.components.PreferencesDialog$PreferencesFIBController" trackViewPortWidth="true" trackViewPortHeight="true" align="left" width="99" height="99" sizeAdjustment="OriginalSize">
  <Label id="176" name="ThemesLabel" label="themes" localize="true" align="left" constraints="twocols(expandHorizontally=true;expandVertically=false;index=0;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=center)" />
  <Table id="177" name="themeTable" data="data.themes" selected="data.selectedTheme" iteratorClassName="org.openflexo.fml.controller.theme.FMLEditorTheme" visibleRowCount="4" rowHeight="18" autoSelectFirstRow="false" selectionMode="SingleSelection" manageDynamicModel="true" localize="true" showFooter="false" constraints="twocols(expandHorizontally=true;expandVertically=true;index=1;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=center)">
    <LabelColumn id="178" name="name" data="(iterator == data.usedTheme) ? (&quot;&lt;html&gt;&lt;b&gt;&quot; + iterator.name + &quot; (active)&lt;/b&gt;&lt;/html&gt;&quot;) : iterator.name" title="theme_name" displayTitle="true" columnWidth="200" resizable="true" showIcon="false" />
  </Table>
  <Panel id="180" name="ThemeButtons" layout="flow" border="empty" borderTop="0" borderLeft="0" borderRight="0" borderBottom="0" constraints="twocols(expandHorizontally=true;expandVertically=false;index=2;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=center)">
    <Button id="181" name="new_themeButton" action="data.createTheme()" buttonType="Trigger" label="new_theme" localize="true" constraints="flow(index=0)" />
    <Button id="182" name="duplicate_themeButton" action="data.duplicateSelectedTheme()" buttonType="Trigger" label="duplicate_theme" localize="true" constraints="flow(index=1)" enable="data.selectedTheme != null" />
    <Button id="183" name="delete_themeButton" action="data.deleteSelectedTheme()" buttonType="Trigger" label="delete_theme" localize="true" constraints="flow(index=2)" enable="data.canDeleteSelectedTheme()" />
    <Button id="321" name="use_themeButton" action="data.useSelectedTheme()" buttonType="Trigger" label="use_theme" localize="true" constraints="flow(index=3)" enable="data.selectedTheme != null" />
    <Button id="185" name="import_themeButton" action="data.importTheme()" buttonType="Trigger" label="import_theme" localize="true" constraints="flow(index=4)" />
    <Button id="186" name="export_themeButton" action="data.exportSelectedTheme()" buttonType="Trigger" label="export_theme" localize="true" constraints="flow(index=5)" enable="data.selectedTheme != null" />
  </Panel>
  <Label id="187" name="ReadOnlyLabel" label="read_only_theme" localize="true" align="left" visible="data.selectedTheme != null &amp;&amp; !data.selectedTheme.editable" constraints="twocols(expandHorizontally=true;expandVertically=false;index=3;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=center)" />
  <Label id="188" name="NameLabel" label="theme_name" localize="true" align="left" constraints="twocols(expandHorizontally=true;expandVertically=false;index=4;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=left)" />
  <TextField id="189" name="NameField" data="data.selectedThemeName" columns="20" enable="data.canRenameSelectedTheme()" constraints="twocols(expandHorizontally=true;expandVertically=false;index=5;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=right)" />
  <Label id="190" name="BackgroundLabel" label="editor_background" localize="true" align="left" constraints="twocols(expandHorizontally=true;expandVertically=false;index=6;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=left)" />
  <Color id="191" name="BackgroundColor" data="data.selectedTheme.background" enable="data.selectedTheme.editable" constraints="twocols(expandHorizontally=true;expandVertically=false;index=7;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=right)" />
  <Label id="192" name="CurrentLineLabel" label="current_line" localize="true" align="left" constraints="twocols(expandHorizontally=true;expandVertically=false;index=8;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=left)" />
  <Color id="193" name="CurrentLineColor" data="data.selectedTheme.currentLineHighlight" enable="data.selectedTheme.editable" constraints="twocols(expandHorizontally=true;expandVertically=false;index=9;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=right)" />
  <Table id="194" name="tokenTable" data="data.selectedTheme.tokenStyles" iteratorClassName="org.openflexo.fml.controller.theme.FMLTokenStyle" visibleRowCount="10" rowHeight="18" autoSelectFirstRow="true" selectionMode="SingleSelection" manageDynamicModel="true" localize="true" showFooter="false" constraints="twocols(expandHorizontally=true;expandVertically=true;index=10;insetsBottom=2;insetsLeft=10;insetsRight=10;insetsTop=2;location=center)">
    <LabelColumn id="195" name="token" data="iterator.label" title="token_type" displayTitle="true" columnWidth="200" resizable="true" showIcon="false" />
    <CustomColumn id="310" name="color" componentClassName="org.openflexo.gina.swing.utils.FIBColorSelector" customRendering="true" data="iterator.foreground" title="color" displayTitle="true" columnWidth="60" resizable="false" showIcon="false" />
    <CheckBoxColumn id="196" name="bold" data="iterator.bold" title="bold" displayTitle="true" columnWidth="50" resizable="false" showIcon="false" />
    <CheckBoxColumn id="197" name="italic" data="iterator.italic" title="italic" displayTitle="true" columnWidth="50" resizable="false" showIcon="false" />
  </Table>
