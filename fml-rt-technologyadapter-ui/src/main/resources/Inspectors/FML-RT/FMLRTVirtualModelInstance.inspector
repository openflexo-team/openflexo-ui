<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols"
	hGap="5" vGap="5" cols="2" rows="2" flowAlignment="LEFT" boxLayoutAxis="X_AXIS"
	titleFont="SansSerif,0,12" darkLevel="0"
	dataClassName="org.openflexo.foundation.fml.rt.FMLRTVirtualModelInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController"
	font="SansSerif,0,12" name="Inspector">
	<TabPanel name="Tab"
		constraints="twocols(alignmentX=0.5;alignmentY=0.5;anchor=center;expandHorizontally=true;expandVertically=true;fill=none;gridHeight=1;gridWidth=1;gridX=-1;gridY=-1;insetsBottom=0;insetsLeft=0;insetsRight=0;insetsTop=0;location=pageStart;padX=0;padY=0;weightX=0.0;weightY=0.0;x=0;y=0)">
		<Tab title="Basic" layout="twocols" titleFont="SansSerif,0,11"
			darkLevel="0" index="0" font="SansSerif,0,11" useScrollBar="true"
			horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
			verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED" name="BasicTab">
			<!-- Same names and indexes as in VirtualModelInstance.inspector: when merging, these redefinitions replace
			     the inherited read-only TextField showing the VirtualModel name. Same widget as for the unloaded
			     resource (FMLRTVirtualModelInstanceResource.inspector); valueValidator="false" prevents any write-back. -->
			<Label label="virtual_model" index="8"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=6;location=left)"
				name="VirtualModelNameLabel" localize="true" />
			<Custom componentClassName="org.openflexo.fml.controller.widget.FIBVirtualModelSelector"
				index="9" data="data.virtualModel.resource" valueValidator="false"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=7;location=right)"
				localize="true" manageDynamicModel="true" name="VirtualModelName">
				<Assignment variable="component.virtualModelLibrary"
					value="data.serviceManager.virtualModelLibrary" mandatory="true" />
			</Custom>
		</Tab>
	</TabPanel>
	<LocalizedDictionary>
		<Localized key="virtual_model" lang="English" value="Virtual model" />
		<Localized key="virtual_model" lang="French" value="Virtual model" />
		<Localized key="virtual_model" lang="Dutch" value="Virtual model" />
	</LocalizedDictionary>
	<Parameter name="title" value="Virtual model instance" />
</Panel>
