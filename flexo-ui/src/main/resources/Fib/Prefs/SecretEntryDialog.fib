<?xml version="1.0" encoding="UTF-8"?>
<Panel layout="border" dataClassName="org.openflexo.prefs.SecretEntryDialog" width="420" height="160" opaque="false">
  <Panel layout="twocols" constraints="border(location=center)" opaque="false">
    <Label label="secret_name" localize="true" constraints="twocols(expandHorizontally=true;expandVertically=false;index=0;insetsBottom=0;insetsLeft=5;insetsRight=5;insetsTop=5;location=left)">
      <LocalizedDictionary />
    </Label>
    <TextField columns="7" passwd="false" text="TextField" data="data.name" enable="!(data.editingExistingKey)" constraints="twocols(expandHorizontally=true;expandVertically=false;index=0;insetsBottom=0;insetsLeft=5;insetsRight=5;insetsTop=5;location=right)" localize="false" />
    <Label label="secret_value" localize="true" constraints="twocols(expandHorizontally=true;expandVertically=false;index=1;insetsBottom=0;insetsLeft=5;insetsRight=5;insetsTop=5;location=left)">
      <LocalizedDictionary />
    </Label>
    <TextField columns="7" passwd="true" text="TextField" data="data.value" constraints="twocols(expandHorizontally=true;expandVertically=false;index=1;insetsBottom=0;insetsLeft=5;insetsRight=5;insetsTop=5;location=right)" localize="false" />
    <Panel layout="flow" hGap="5" vGap="5" flowAlignment="CENTER" borderTop="10" borderBottom="2" borderLeft="2" borderRight="2" constraints="twocols(expandHorizontally=true;expandVertically=false;index=2;insetsBottom=0;insetsLeft=5;insetsRight=5;insetsTop=5;location=center)" opaque="false">
      <Button action="controller.validateAndDispose()" default="true" buttonType="Trigger" label="OK" constraints="flow(index=0)" name="ok" localize="true" enable="((data.name != null) &amp;&amp; (!(data.name.trim.isEmpty)) &amp;&amp; (data.value != null) &amp;&amp; (!(data.value.isEmpty)))">
        <LocalizedDictionary />
      </Button>
      <Button action="controller.cancelAndDispose()" buttonType="Trigger" label="Cancel" constraints="flow(index=1)" localize="true">
      </Button>
    </Panel>
  </Panel>
  <LocalizedDictionary>
    <Localized lang="English" value="Name" key="secret_name" />
    <Localized lang="French" value="Nom" key="secret_name" />
    <Localized lang="English" value="Value" key="secret_value" />
    <Localized lang="French" value="Valeur" key="secret_value" />
  </LocalizedDictionary>
</Panel>
