<?xml version="1.0" encoding="UTF-8"?>
<Panel id="0" align="left" borderTop="5" borderLeft="0" trackViewPortHeight="true" trackViewPortWidth="true" borderBottom="0" border="empty" sizeAdjustment="OriginalSize" titleFont="Lucida Grande,0,13" layout="border" borderRight="0" height="99" width="99" controllerClassName="org.openflexo.components.PreferencesDialog$PreferencesFIBController" name="SecretsPreferencesPanel">
  <Label id="1" label="secrets_description" align="left" localize="true" constraints="border(location=north)" index="0" name="DescriptionLabel">
    <LocalizedDictionary id="2">
      <Localized id="3" lang="English" value="Secrets stored here (API tokens, passwords, ...) never leave this machine and are never saved in a project. Reference a secret by name from a technology adapter connection (e.g. the REST access point's 'secretRef' field)." key="secrets_description" />
      <Localized id="4" lang="French" value="Les secrets stockés ici (tokens d'API, mots de passe, ...) ne quittent jamais cette machine et ne sont jamais enregistrés dans un projet. Référencez un secret par son nom depuis une connexion de technology adapter (par exemple le champ 'secretRef' d'un access point REST)." key="secrets_description" />
    </LocalizedDictionary>
  </Label>
  <Table id="5" backgroundSelectionColor="41,90,209" visibleRowCount="8" backgroundNonSelectionColor="255,255,255" iteratorClassName="java.lang.String" textSelectionColor="255,255,255" backgroundSecondarySelectionColor="173,215,255" showFooter="false" autoSelectFirstRow="true" textSecondarySelectionColor="0,0,0" textNonSelectionColor="0,0,0" selectionMode="SingleSelection" rowHeight="18" localize="true" manageDynamicModel="true" data="data.secretKeys" constraints="border(expandHorizontally=true;expandVertically=true;location=center)" index="1" font="Lucida Grande,0,11" name="secretsTable">
    <LabelColumn id="6" data="iterator" resizable="true" title="secret_name" displayTitle="true" columnWidth="200" showIcon="false" name="name" />
  </Table>
  <Panel id="7" align="left" borderTop="0" borderLeft="0" trackViewPortHeight="true" trackViewPortWidth="true" borderBottom="0" border="empty" sizeAdjustment="OriginalSize" titleFont="SansSerif,0,12" layout="flow" flowAlignment="LEADING" vGap="0" borderRight="0" hGap="5" constraints="border(expandHorizontally=true;expandVertically=false;location=south)" index="2" name="ButtonsPanel">
    <Button id="8" buttonType="Trigger" action="data.addSecret()" label="add" localize="true" constraints="flow(index=0)" name="AddButton" />
    <Button id="9" buttonType="Trigger" action="data.editSecret(secretsTable.selected)" label="edit" localize="true" enable="secretsTable.selected != null" constraints="flow(index=1)" name="EditButton" />
    <Button id="10" buttonType="Trigger" action="data.removeSecret(secretsTable.selected)" label="remove" localize="true" enable="secretsTable.selected != null" constraints="flow(index=2)" name="RemoveButton" />
  </Panel>
  <LocalizedDictionary id="11">
    <Localized id="12" lang="English" value="Name" key="secret_name" />
    <Localized id="13" lang="French" value="Nom" key="secret_name" />
    <Localized id="14" lang="English" value="Add..." key="add" />
    <Localized id="15" lang="French" value="Ajouter..." key="add" />
    <Localized id="16" lang="English" value="Edit..." key="edit" />
    <Localized id="17" lang="French" value="Modifier..." key="edit" />
    <Localized id="18" lang="English" value="Remove" key="remove" />
    <Localized id="19" lang="French" value="Supprimer" key="remove" />
  </LocalizedDictionary>
  <FIBVariable id="20" type="org.openflexo.prefs.SecretsPreferences" name="data" />
</Panel>
